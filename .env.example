# Stripe TEST mode keys of the Stripe account that plays the "AnswerForce US platform" account.
# Dashboard → Developers → API keys (make sure "Test mode" is on).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Optional – only if you run `stripe listen` yourself instead of the stripe-cli container.
STRIPE_WEBHOOK_SECRET=

# ACH Direct Debit (optional – defaults shown)
# automatic = Financial Connections + manual entry/microdeposits fallback, instant = Financial Connections only
ACH_VERIFICATION_METHOD=automatic
# false = DS task only on a bank return (phase 1), true = also reverse the jBilling payment (phase 2)
ACH_REVERSE_JBILLING_PAYMENT_ON_FAILURE=false
